# Keep the docker/Dockerfile build context small and free of host-specific artifacts. The `dev`
# target creates its own venv and installs into it inside the container, so a host-built .venv
# (with absolute paths baked into its symlinks, which won't resolve inside the container) must
# never be copied in. .git/ is NOT excluded: the `dev` target's versions come from
# setuptools-scm/hatch-vcs, which need real git metadata -- a shallow/absent .git breaks them.
.venv/
**/.venv/
**/__pycache__/
*.pyc
dist/
**/dist/
htmlcov/
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
# Host C++ build trees (cxx10x/.gitignore); the image builds its own.
/build/
# A host's build mode (`./xx-build set-mode`); the image sets its own.
/uv.toml
cxx10x/**/cmake-build*/
cxx10x/**/build/
cxx10x/_deps/
